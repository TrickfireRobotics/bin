#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

STATUS=0

ok() { printf "  ${GREEN}✔${RESET}  %-28s ${GREEN}%s${RESET}\n" "$1" "$2"; }
warn() {
	printf "  ${YELLOW}⚠${RESET}  %-28s ${YELLOW}%s${RESET}\n" "$1" "$2"
	STATUS=1
}
fail() {
	printf "  ${RED}✘${RESET}  %-28s ${RED}%s${RESET}\n" "$1" "$2"
	STATUS=1
}

HOST=$(hostname)
MODEL=$(tr -d '\0' </proc/device-tree/model 2>/dev/null)

printf "\n${BOLD}${CYAN}------------------------------------------${RESET}\n"
printf "${BOLD}${CYAN}  %s%s${RESET}\n" "$HOST" "${MODEL:+  ($MODEL)}"
printf "${BOLD}${CYAN}------------------------------------------${RESET}\n"

# --- Power mode ---
power_mode=$(sudo -n nvpmodel -q 2>/dev/null | grep "NV Power Mode" | cut -d: -f2 | xargs)
if [[ "$power_mode" == "MAXN" ]]; then
	ok "Power mode" "$power_mode"
elif [[ -z "$power_mode" ]]; then
	warn "Power mode" "unknown  (needs passwordless sudo for nvpmodel)"
else
	warn "Power mode" "$power_mode  (expected MAXN)"
fi

# --- CPUs ---
cpu_online=$(cat /sys/devices/system/cpu/online 2>/dev/null)
if [[ "$cpu_online" == "0-7" ]]; then
	ok "CPUs online" "all 8  ($cpu_online)"
else
	warn "CPUs online" "${cpu_online:-unknown}  (expected 0-7)"
fi

# --- GPU ---
gpu_freq=$(cat /sys/class/devfreq/*/cur_freq 2>/dev/null | head -1)
if [[ -n "$gpu_freq" ]]; then
	gpu_mhz=$((gpu_freq / 1000000))
	if [[ $gpu_mhz -ge 1000 ]]; then
		ok "GPU frequency" "${gpu_mhz} MHz"
	else
		warn "GPU frequency" "${gpu_mhz} MHz  (low)"
	fi
else
	warn "GPU frequency" "unknown"
fi

# --- Fan ---
fan_profile=$(cat /sys/devices/platform/thermal_fan_est/fan_profile 2>/dev/null)
fan_pwm=$(cat /sys/class/hwmon/hwmon*/pwm1 2>/dev/null | head -1)

if [[ "$fan_pwm" == "255" || "$fan_profile" == full* ]]; then
	ok "Fan profile" "full  (pwm=${fan_pwm:-?})"
elif [[ "$fan_profile" == "quiet" || "$fan_profile" == "cool" ]]; then
	fail "Fan profile" "$fan_profile  (should be full, pwm=${fan_pwm:-?})"
else
	warn "Fan profile" "${fan_profile:-unknown}  (pwm=${fan_pwm:-?})"
fi

# --- Thermals ---
while IFS=$'\t' read -r zone temp_raw; do
	[[ -z "$zone" || -z "$temp_raw" ]] && continue
	temp_c=$((temp_raw / 1000))
	if [[ $temp_c -ge 80 ]]; then
		fail "Temp: $zone" "${temp_c}°C  (critical)"
	elif [[ $temp_c -ge 65 ]]; then
		warn "Temp: $zone" "${temp_c}°C  (warm)"
	fi
done < <(paste /sys/devices/virtual/thermal/thermal_zone*/type \
	/sys/devices/virtual/thermal/thermal_zone*/temp 2>/dev/null)

# --- Network ---
eth_carrier=$(cat /sys/class/net/eth0/carrier 2>/dev/null)
active_iface=$(ip route get 8.8.8.8 2>/dev/null | grep -oP "dev \K\S+")
wifi_pm=$(iwconfig wlan0 2>/dev/null | grep -oP "Power Management:\K\S+")

if [[ "$eth_carrier" == "1" ]]; then
	ok "Ethernet" "connected"
else
	warn "Ethernet" "no carrier  (using ${active_iface:-unknown})"
fi

if [[ "$wifi_pm" == "off" ]]; then
	ok "WiFi power management" "off"
else
	warn "WiFi power management" "${wifi_pm:-unknown}  (should be off)"
fi

# --- Services ---
svc_jetson=$(systemctl is-active jetson-clocks.service 2>/dev/null)
svc_wifi=$(systemctl is-active wifi-disable-powersave.service 2>/dev/null)

if [[ "$svc_jetson" == "active" ]]; then
	ok "jetson-clocks.service" "active"
else
	fail "jetson-clocks.service" "${svc_jetson:-inactive}"
fi

if [[ "$svc_wifi" == "active" ]]; then
	ok "wifi-disable-powersave" "active"
else
	fail "wifi-disable-powersave" "${svc_wifi:-inactive}"
fi

printf "\n"
exit $STATUS
