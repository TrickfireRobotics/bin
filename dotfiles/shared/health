#!/bin/bash

if [[ $EUID -ne 0 ]]; then
	exec sudo "$0" "$@"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

STATUS=0

ok() { printf "  ${GREEN}✔${RESET}  %-28s ${GREEN}%s${RESET}\n" "$1" "$2"; }
warn() {
	printf "  ${YELLOW}⚠${RESET}  %-28s ${YELLOW}%s${RESET}\n" "$1" "$2"
	STATUS=1
}
fail() {
	printf "  ${RED}✘${RESET}  %-28s ${RED}%s${RESET}\n" "$1" "$2"
	STATUS=1
}

HOST=$(hostname)
MODEL=$(tr -d '\0' </proc/device-tree/model 2>/dev/null)

printf "\n${BOLD}${CYAN}------------------------------------------${RESET}\n"
printf "${BOLD}${CYAN}  %s%s${RESET}\n" "$HOST" "${MODEL:+  ($MODEL)}"
printf "${BOLD}${CYAN}------------------------------------------${RESET}\n"

# --- Power mode ---
power_mode=$(nvpmodel -q 2>/dev/null | grep "NV Power Mode" | cut -d: -f2 | xargs)
if [[ "$power_mode" == "MAXN" ]]; then
	ok "Power mode" "$power_mode"
else
	warn "Power mode" "${power_mode:-unknown}  (expected MAXN)"
fi

# --- CPUs ---
# Expected range is derived from the actual core count so this works across
# boards with different CPU counts (e.g. 8-core vs 12-core Orin variants).
total_cpus=$(nproc --all 2>/dev/null)
expected_cpu_range="0-$((total_cpus - 1))"
cpu_online=$(cat /sys/devices/system/cpu/online 2>/dev/null)
if [[ -n "$total_cpus" && "$cpu_online" == "$expected_cpu_range" ]]; then
	ok "CPUs online" "all $total_cpus  ($cpu_online)"
else
	warn "CPUs online" "${cpu_online:-unknown}  (expected $expected_cpu_range)"
fi

# --- GPU ---
gpu_freq=""
for d in /sys/class/devfreq/*; do
	case "$(basename "$d")" in
	*ga10b* | *gpu*)
		gpu_freq=$(cat "$d/cur_freq" 2>/dev/null)
		break
		;;
	esac
done
if [[ -n "$gpu_freq" ]]; then
	gpu_mhz=$((gpu_freq / 1000000))
	if [[ $gpu_mhz -ge 1000 ]]; then
		ok "GPU frequency" "${gpu_mhz} MHz"
	else
		warn "GPU frequency" "${gpu_mhz} MHz  (low)"
	fi
else
	warn "GPU frequency" "unknown"
fi

# --- Fan ---
fan_pwm=$(cat /sys/class/hwmon/hwmon*/pwm1 2>/dev/null | head -1)

if [[ "$fan_pwm" == "255" ]]; then
	ok "Fan speed" "full  (pwm=$fan_pwm)"
else
	warn "Fan speed" "${fan_pwm:-unknown}/255  (expected full/255)"
fi

# --- Thermals ---
for tz in /sys/devices/virtual/thermal/thermal_zone*; do
	[[ -f "$tz/type" && -f "$tz/temp" ]] || continue
	zone=$(<"$tz/type")
	temp_raw=$(<"$tz/temp")
	[[ -z "$temp_raw" || "$temp_raw" -lt 0 ]] && continue
	temp_c=$((temp_raw / 1000))
	if [[ $temp_c -ge 80 ]]; then
		fail "Temp: $zone" "${temp_c}°C  (critical)"
	elif [[ $temp_c -ge 65 ]]; then
		warn "Temp: $zone" "${temp_c}°C  (warm)"
	fi
done

# --- Network ---
# Interface names vary by L4T predictable-naming scheme (eth0/wlan0 vs
# end0/wlP1p1s0 etc.), so detect the real physical ethernet and wifi
# interfaces instead of hardcoding names.
eth_iface=""
for d in /sys/class/net/*; do
	ifn=$(basename "$d")
	[[ -e "$d/wireless" ]] && continue
	case "$(readlink -f "$d")" in
	*/devices/virtual/*) continue ;;
	esac
	[[ "$(cat "$d/type" 2>/dev/null)" == "1" ]] || continue
	eth_iface="$ifn"
	break
done
wifi_iface=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2; exit}')

eth_carrier=$(cat "/sys/class/net/${eth_iface}/carrier" 2>/dev/null)
active_iface=$(ip route get 8.8.8.8 2>/dev/null | grep -oP "dev \K\S+")
wifi_pm=$(iw dev "$wifi_iface" get power_save 2>/dev/null | grep -oP "Power save: \K\S+")

if [[ "$eth_carrier" == "1" ]]; then
	ok "Ethernet" "connected  (${eth_iface})"
else
	warn "Ethernet" "no carrier  (using ${active_iface:-unknown})"
fi

if [[ "$wifi_pm" == "off" ]]; then
	ok "WiFi power management" "off"
else
	warn "WiFi power management" "${wifi_pm:-unknown}  (should be off)"
fi

# --- Services ---
# nvpmodel.service is a oneshot unit: it runs at boot and goes back to
# "inactive" on success, so is-active would always false-fail here.
svc_nvpmodel=$(systemctl is-failed nvpmodel.service 2>/dev/null)
svc_nvfancontrol=$(systemctl is-active nvfancontrol.service 2>/dev/null)

if [[ "$svc_nvpmodel" != "failed" ]]; then
	ok "nvpmodel.service" "ran successfully"
else
	fail "nvpmodel.service" "failed"
fi

if [[ "$svc_nvfancontrol" == "active" ]]; then
	ok "nvfancontrol.service" "active"
else
	fail "nvfancontrol.service" "${svc_nvfancontrol:-inactive}"
fi

printf "\n"
exit $STATUS
